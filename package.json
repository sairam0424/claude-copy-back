{
  "name": "claude-copy-back",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Experimental Claude Code mod for macOS: type /cc after copying text from the terminal to put Claude's own text for it back on the clipboard, without the margin and the hard line breaks. Zero dependencies; Node runs the TypeScript as is (erasable syntax only).",
  "license": "MIT",
  "author": "Sairam Ugge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sairam0424/claude-copy-back.git"
  },
  "bugs": {
    "url": "https://github.com/sairam0424/claude-copy-back/issues"
  },
  "homepage": "https://github.com/sairam0424/claude-copy-back#readme",
  "keywords": ["claude-code-mod", "clipboard", "copy", "terminal"],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.mts\"",
    "test:rig": "node --test --test-concurrency=1 \"realrender/tests/*.test.mjs\"",
    "selftest": "node scripts/replay.mjs --selftest",
    "k1": "node scripts/replay.mjs --seed 1 --messages 250 --widths 60,80,100,120",
    "kit-test": "bash scripts/kit-test.sh",
    "footprint": "bash scripts/check-footprint.sh",
    "sources": "node scripts/check-sources.mjs",
    "typecheck": "bash scripts/typecheck.sh",
    "lint:sh": "shellcheck -S warning scripts/*.sh",
    "check": "npm run sources && npm run lint:sh && npm run footprint && npm run typecheck",
    "validate": "claude plugin validate . --strict"
  }
}
